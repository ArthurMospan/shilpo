# Telegram bot from @BotFather
BOT_TOKEN=replace_me

# Public HTTPS address that serves the Mini App and the OAuth callback.
WEBAPP_URL=https://replace_me

# Comma-separated Gemini keys; the code rotates across them on quota errors.
GEMINI_API_KEY=replace_me

# Required for webhook mode (Vercel). Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header, which is what proves an update is
# genuine. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=replace_me

PORT=3000
NODE_ENV=production

# Persistent remote SQLite-compatible database (Turso/libSQL).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_me
DATABASE_PATH=/data/database.sqlite
